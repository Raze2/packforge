{
  "openapi": "3.1.0",
  "info": {
    "title": "PackForge API",
    "version": "1.2.0",
    "description": "Render and export parametric packaging designs. All lengths are millimetres. Responses are deterministic for the same input."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Liveness check",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    },
    "/v1/components": {
      "get": {
        "summary": "List components",
        "responses": {
          "200": {
            "description": "Catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ComponentSummary"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/components/{id}": {
      "get": {
        "summary": "Describe a component (parameter schema)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "fefco-0201"
          }
        ],
        "responses": {
          "200": {
            "description": "Component with parameter definitions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentInfo"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/boards": {
      "get": {
        "summary": "List board presets",
        "responses": {
          "200": {
            "description": "Board presets (nominal calipers)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Board"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/render": {
      "post": {
        "summary": "Render a design to die-line, fold model and stats",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project"
                ],
                "properties": {
                  "project": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Render result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/export": {
      "post": {
        "summary": "Export a design as a file",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "ETag from a previous identical export"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project",
                  "format"
                ],
                "properties": {
                  "project": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "svg",
                      "dxf",
                      "pdf",
                      "cf2",
                      "hpgl",
                      "glb"
                    ]
                  },
                  "options": {
                    "$ref": "#/components/schemas/ExportOptions"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File bytes; Content-Disposition carries the filename",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/dxf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/vnd.cf2": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/vnd.hp-hpgl": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "model/gltf-binary": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "Not modified"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/nest": {
      "post": {
        "summary": "How many blanks fit on a sheet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project",
                  "nesting"
                ],
                "properties": {
                  "project": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "nesting": {
                    "$ref": "#/components/schemas/Nesting"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nesting summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NestSummary"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/fold": {
      "post": {
        "summary": "3D panel positions of the folded design",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project"
                ],
                "properties": {
                  "project": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "progress": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Panels with 3D corners (mm) and normals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pallet": {
      "post": {
        "summary": "Pallet plan for a design",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project"
                ],
                "properties": {
                  "project": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "pallet": {
                    "$ref": "#/components/schemas/PalletRequest"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pattern, per layer, layers, total, efficiencies, box positions of one layer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/pallet/report": {
      "post": {
        "summary": "Pallet plan as an A4 PDF report",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project"
                ],
                "properties": {
                  "project": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "pallet": {
                    "$ref": "#/components/schemas/PalletRequest"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/case-optimize": {
      "post": {
        "summary": "Case sizes for N products, ranked by board per product (or products per pallet)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked candidates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key, e.g. pk_live_\u2026"
      }
    },
    "responses": {
      "Problem": {
        "description": "Error (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "rate_limited",
              "not_found",
              "invalid_request",
              "invalid_params",
              "unknown_component",
              "unknown_board",
              "unknown_format",
              "rule_violation",
              "geometry_error",
              "library_error",
              "export_error",
              "fold_error"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "param": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Board": {
        "type": "object",
        "required": [
          "id",
          "caliper_mm"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "caliper_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "flute": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "component_id",
          "board"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "example": "fefco-0201"
          },
          "component_version": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            "example": {
              "L": 300,
              "W": 200,
              "H": 150
            }
          },
          "board": {
            "oneOf": [
              {
                "type": "string",
                "description": "Board preset id",
                "example": "C-flute"
              },
              {
                "$ref": "#/components/schemas/Board"
              }
            ]
          },
          "units": {
            "type": "string",
            "enum": [
              "mm",
              "cm",
              "in"
            ],
            "default": "mm"
          }
        }
      },
      "ComponentSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "standard": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "free",
              "premium"
            ]
          }
        }
      },
      "ComponentInfo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ComponentSummary"
          },
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "dimension_reference": {
                "type": "string"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "length",
                        "number",
                        "angle",
                        "bool",
                        "enum"
                      ]
                    },
                    "default": {
                      "type": [
                        "number",
                        "string",
                        "boolean"
                      ]
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "group": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Stats": {
        "type": "object",
        "properties": {
          "blank_width": {
            "type": "number"
          },
          "blank_height": {
            "type": "number"
          },
          "blank_area_m2": {
            "type": "number"
          },
          "outline_area_m2": {
            "type": "number"
          },
          "cut_length": {
            "type": "number"
          },
          "crease_length": {
            "type": "number"
          }
        }
      },
      "RenderResult": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string"
          },
          "component_version": {
            "type": "string"
          },
          "board": {
            "$ref": "#/components/schemas/Board"
          },
          "dieline": {
            "type": "object",
            "description": "Entities with line_type and path segments (mm, y up)"
          },
          "fold": {
            "type": "object",
            "description": "Panels and hinges for 3D folding"
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warning",
                    "error"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Nesting": {
        "type": "object",
        "required": [
          "sheet_width",
          "sheet_height"
        ],
        "properties": {
          "sheet_width": {
            "type": "number"
          },
          "sheet_height": {
            "type": "number"
          },
          "gap": {
            "type": "number",
            "default": 8
          },
          "margin": {
            "type": "number",
            "default": 10
          },
          "allow_rotation": {
            "type": "boolean",
            "default": true
          },
          "max_count": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "ExportOptions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rotate": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ],
            "default": 0
          },
          "mirror": {
            "type": "boolean",
            "default": false
          },
          "nesting": {
            "$ref": "#/components/schemas/Nesting"
          },
          "page": {
            "type": "string",
            "enum": [
              "actual",
              "a4",
              "a3",
              "letter"
            ],
            "description": "PDF only; default actual (1:1)"
          },
          "watermark": {
            "type": "string",
            "description": "PDF only"
          },
          "profile": {
            "type": "string",
            "enum": [
              "standard",
              "cut-crease"
            ],
            "description": "Line-type mapping for DXF layers, CF2 types and HPGL pens"
          },
          "custom_profile": {
            "type": "object",
            "description": "Full output profile (id, name, lines: {cut: {layer, cf2_type, cf2_pointage, pen, include}, ...})"
          }
        }
      },
      "NestSummary": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "cols": {
            "type": "integer"
          },
          "rows": {
            "type": "integer"
          },
          "rotated": {
            "type": "boolean"
          },
          "blank_width": {
            "type": "number"
          },
          "blank_height": {
            "type": "number"
          },
          "sheet_area_m2": {
            "type": "number"
          },
          "utilisation": {
            "type": "number"
          }
        }
      },
      "PalletRequest": {
        "type": "object",
        "properties": {
          "pallet": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "eur",
                  "eur-half",
                  "iso-1200x1000",
                  "gma",
                  "asia"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "length": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                }
              }
            ],
            "default": "eur"
          },
          "max_height": {
            "type": "number",
            "default": 1800
          },
          "box_weight": {
            "type": "number"
          },
          "max_weight": {
            "type": "number"
          },
          "overhang": {
            "type": "number",
            "default": 0
          },
          "allow_on_side": {
            "type": "boolean",
            "default": false
          },
          "box_outer": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Measured outer size; default inside + 2 calipers"
          }
        }
      },
      "CaseRequest": {
        "type": "object",
        "required": [
          "product",
          "count"
        ],
        "properties": {
          "product": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "component_id": {
            "type": "string",
            "default": "fefco-0201"
          },
          "board": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/Board"
              }
            ],
            "default": "C-flute"
          },
          "clearance": {
            "type": "number",
            "default": 4
          },
          "allow_rotation": {
            "type": "boolean",
            "default": true
          },
          "max_results": {
            "type": "integer",
            "default": 10
          },
          "pallet": {
            "$ref": "#/components/schemas/PalletRequest"
          },
          "board_price_per_m2": {
            "type": "number"
          }
        }
      }
    }
  }
}
