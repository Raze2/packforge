{
  "openapi": "3.1.0",
  "info": {
    "title": "PackForge API",
    "version": "1.0.0",
    "description": "Render and export parametric packaging designs. All lengths are millimetres. Responses are deterministic for the same input."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearer": [] }],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Liveness check",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is up",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": { "200": { "description": "OpenAPI document" } }
      }
    },
    "/v1/components": {
      "get": {
        "summary": "List components",
        "responses": {
          "200": {
            "description": "Catalogue",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ComponentSummary" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/components/{id}": {
      "get": {
        "summary": "Describe a component (parameter schema)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "example": "fefco-0201" }],
        "responses": {
          "200": {
            "description": "Component with parameter definitions",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComponentInfo" } } }
          },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/boards": {
      "get": {
        "summary": "List board presets",
        "responses": {
          "200": {
            "description": "Board presets (nominal calipers)",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Board" } } }
            }
          }
        }
      }
    },
    "/v1/render": {
      "post": {
        "summary": "Render a design to die-line, fold model and stats",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["project"],
                "properties": { "project": { "$ref": "#/components/schemas/Project" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Render result",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RenderResult" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/export": {
      "post": {
        "summary": "Export a design as a file",
        "parameters": [
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" }, "description": "ETag from a previous identical export" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["project", "format"],
                "properties": {
                  "project": { "$ref": "#/components/schemas/Project" },
                  "format": { "type": "string", "enum": ["svg", "dxf"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File bytes; Content-Disposition carries the filename",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": {
              "image/svg+xml": { "schema": { "type": "string", "format": "binary" } },
              "application/dxf": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "304": { "description": "Not modified" },
          "400": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer", "description": "API key, e.g. pk_live_…" } },
    "responses": {
      "Problem": {
        "description": "Error (RFC 7807)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": { "status": { "type": "string" }, "version": { "type": "string" } }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "code": {
            "type": "string",
            "enum": ["unauthorized", "rate_limited", "not_found", "invalid_request", "invalid_params", "unknown_component", "unknown_board", "unknown_format", "rule_violation", "geometry_error", "library_error"]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "param": { "type": "string" }, "message": { "type": "string" } }
            }
          }
        }
      },
      "Board": {
        "type": "object",
        "required": ["id", "caliper_mm"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "caliper_mm": { "type": "number", "exclusiveMinimum": 0 },
          "flute": { "type": "string" }
        }
      },
      "Project": {
        "type": "object",
        "required": ["component_id", "board"],
        "properties": {
          "component_id": { "type": "string", "example": "fefco-0201" },
          "component_version": { "type": "string" },
          "params": {
            "type": "object",
            "additionalProperties": { "type": ["number", "string", "boolean"] },
            "example": { "L": 300, "W": 200, "H": 150 }
          },
          "board": {
            "oneOf": [
              { "type": "string", "description": "Board preset id", "example": "C-flute" },
              { "$ref": "#/components/schemas/Board" }
            ]
          },
          "units": { "type": "string", "enum": ["mm", "cm", "in"], "default": "mm" }
        }
      },
      "ComponentSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "name": { "type": "string" },
          "standard": { "type": ["string", "null"] },
          "category": { "type": "string" },
          "tier": { "type": "string", "enum": ["free", "premium"] }
        }
      },
      "ComponentInfo": {
        "allOf": [
          { "$ref": "#/components/schemas/ComponentSummary" },
          {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "dimension_reference": { "type": "string" },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "type": { "type": "string", "enum": ["length", "number", "angle", "bool", "enum"] },
                    "default": { "type": ["number", "string", "boolean"] },
                    "min": { "type": "number" },
                    "max": { "type": "number" },
                    "values": { "type": "array", "items": { "type": "string" } },
                    "group": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      },
      "Stats": {
        "type": "object",
        "properties": {
          "blank_width": { "type": "number" },
          "blank_height": { "type": "number" },
          "blank_area_m2": { "type": "number" },
          "outline_area_m2": { "type": "number" },
          "cut_length": { "type": "number" },
          "crease_length": { "type": "number" }
        }
      },
      "RenderResult": {
        "type": "object",
        "properties": {
          "component_id": { "type": "string" },
          "component_version": { "type": "string" },
          "board": { "$ref": "#/components/schemas/Board" },
          "dieline": { "type": "object", "description": "Entities with line_type and path segments (mm, y up)" },
          "fold": { "type": "object", "description": "Panels and hinges for 3D folding" },
          "stats": { "$ref": "#/components/schemas/Stats" },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "severity": { "type": "string", "enum": ["info", "warning", "error"] }, "message": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
