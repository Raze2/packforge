{
    "name": "packforge/laravel",
    "description": "Laravel client for the PackForge packaging design API, plus the <x-packforge-designer> Blade component.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "packaging",
        "dieline",
        "dxf",
        "packforge"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "PackForge\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PackForge\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PackForge\\Laravel\\PackForgeServiceProvider"
            ],
            "aliases": {
                "PackForge": "PackForge\\Laravel\\Facades\\PackForge"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
