{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/node_modules/vite/bin/vite.js",
        "apps/web",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "shop",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "examples/laravel-shop/artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8000"
      ],
      "port": 8000
    }
  ]
}
